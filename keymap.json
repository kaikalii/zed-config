// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-e": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "bindings": {
      "ctrl-o": "workspace::Open"
    }
  },
  {
    "unbind": {
      "ctrl-k ctrl-o": "workspace::Open"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-p ctrl-p": "pane::TogglePinTab"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k shift-enter": "pane::TogglePinTab"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k w": [
        "pane::CloseAllItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-e": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "unbind": {
      "ctrl-shift-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-shift-w": "workspace::CloseAllItemsAndPanes"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-k ctrl-w": "workspace::CloseAllItemsAndPanes"
    }
  }
]
